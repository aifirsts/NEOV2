<Window x:Class="MATRIX.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MATRIX.App.Views"
        Title="MATRIX V3 — Центр управления NEO"
        Height="900" Width="1600"
        WindowState="Maximized"
        Background="#F5F5F5"
        KeyDown="OnKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu bar -->
        <Menu Grid.Row="0">
            <MenuItem Header="Файл">
                <MenuItem Header="Открыть" Command="{Binding OpenCommand}"/>
                <MenuItem Header="Сохранить" Command="{Binding SaveCommand}"/>
                <MenuItem Header="Импорт..." Command="{Binding ImportCommand}"/>
                <MenuItem Header="Экспорт..." Command="{Binding ExportCommand}"/>
                <Separator/>
                <MenuItem Header="Выход" Click="OnExit"/>
            </MenuItem>
            <MenuItem Header="Правка">
                <MenuItem Header="Добавить узел" Command="{Binding AddNodeCommand}"/>
                <MenuItem Header="Добавить проект" Command="{Binding AddProjectCommand}"/>
                <MenuItem Header="Добавить задачу" Command="{Binding AddTaskCommand}"/>
            </MenuItem>
            <MenuItem Header="Вид">
                <MenuItem Header="Инфраструктура" IsChecked="{Binding ModeInfrastructure, Mode=TwoWay}" IsCheckable="True"/>
                <MenuItem Header="Проекты" IsChecked="{Binding ModeProjects, Mode=TwoWay}" IsCheckable="True"/>
                <MenuItem Header="Безопасность" IsChecked="{Binding ModeSecurity, Mode=TwoWay}" IsCheckable="True"/>
                <MenuItem Header="Восстановление" IsChecked="{Binding ModeRecovery, Mode=TwoWay}" IsCheckable="True"/>
            </MenuItem>
            <MenuItem Header="Справка">
                <MenuItem Header="О программе" Click="OnAbout"/>
            </MenuItem>
        </Menu>

        <!-- Search bar -->
        <ToolBar Grid.Row="1" Background="White">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="4,0"/>
            <TextBox x:Name="SearchBox" Width="250" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="✕" Command="{Binding ClearSearchCommand}" Padding="8,2"/>
            <Separator/>
            <TextBlock Text="{Binding TreeCounts}" VerticalAlignment="Center" Margin="8,0" FontFamily="Consolas"/>
        </ToolBar>

        <!-- Main content: tree | graph + forms | card -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="380" MinWidth="250"/>
            </Grid.ColumnDefinitions>

            <!-- Tree -->
            <DockPanel Grid.Column="0" Margin="4">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource HeaderText}" Text="Каталог"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TreeView ItemsSource="{Binding TreeRoot}" SelectedItemChanged="OnTreeSelectionChanged">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding DisplayName}"/>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </ScrollViewer>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#E0E0E0"/>

            <!-- Graph + Forms -->
            <DockPanel Grid.Column="2" Margin="4">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource HeaderText}" Text="Граф связей"/>
                <views:GraphCanvasView x:Name="GraphView" MinHeight="300" Margin="0,0,0,8"/>
            </DockPanel>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#E0E0E0"/>

            <!-- Detail card + edit forms -->
            <DockPanel Grid.Column="4" Margin="4">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource HeaderText}" Text="Карточка"/>
                <Border Style="{StaticResource CardPanel}" DockPanel.Dock="Top" Margin="0,4">
                    <ContentControl Content="{Binding SelectedDetail}"/>
                </Border>
                <views:EditFormsView/>
            </DockPanel>
        </Grid>

        <!-- Events/errors panel -->
        <Expander Grid.Row="3" Header="События и ошибки" IsExpanded="False" MaxHeight="200">
            <ListBox ItemsSource="{Binding Events}"/>
        </Expander>
    </Grid>
</Window>
