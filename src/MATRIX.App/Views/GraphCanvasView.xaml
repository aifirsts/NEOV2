<UserControl x:Class="MATRIX.App.Views.GraphCanvasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6">
        <Grid>
            <Canvas x:Name="GraphCanvas" ClipToBounds="True" Background="#FAFAFA"/>
            <TextBlock x:Name="EmptyState" Text="Нет данных для отображения графа"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="Gray" FontSize="14"/>
        </Grid>
    </Border>
</UserControl>
