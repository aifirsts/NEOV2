{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:matrix:workspace:v1",
  "title": "MATRIX own interchange workspace v1 (proposed)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "MATRIX_WORKSPACE"
    },
    "schemaVersion": {
      "const": 1
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "catalog": {
      "$ref": "#/$defs/Catalog"
    },
    "state": {
      "$ref": "#/$defs/State"
    }
  },
  "required": [
    "format",
    "schemaVersion",
    "exportedAt",
    "catalog",
    "state"
  ],
  "$defs": {
    "Node": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "device",
            "service",
            "account",
            "vps",
            "project",
            "agent"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "trustZone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sensitivity": {
          "type": "string",
          "enum": [
            "PUBLIC",
            "INTERNAL",
            "SENSITIVE"
          ]
        },
        "availability": {
          "type": "string",
          "enum": [
            "UNKNOWN",
            "UP",
            "DOWN"
          ]
        }
      },
      "required": [
        "id",
        "type",
        "name",
        "owner",
        "trustZone",
        "sensitivity",
        "availability"
      ]
    },
    "Edge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
        },
        "from": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
        },
        "to": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "depends_on",
            "connects_to",
            "authenticates_with",
            "hosted_on",
            "deployed_from",
            "backs_up",
            "monitors",
            "pays_through"
          ]
        },
        "criticality": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ]
        }
      },
      "required": [
        "id",
        "from",
        "to",
        "kind",
        "criticality"
      ]
    },
    "Project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
        },
        "nodeId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
        },
        "goal": {
          "type": "string",
          "maxLength": 4000
        },
        "repoUrl": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        },
        "stage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "nextAction": {
          "type": "string",
          "maxLength": 4000
        },
        "milestones": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      },
      "required": [
        "id",
        "nodeId",
        "goal",
        "repoUrl",
        "stage",
        "nextAction",
        "milestones"
      ]
    },
    "Task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
        },
        "projectId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "type": "string",
          "enum": [
            "TODO",
            "IN_PROGRESS",
            "BLOCKED",
            "DONE"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ]
        },
        "dependencies": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
          }
        }
      },
      "required": [
        "id",
        "projectId",
        "title",
        "status",
        "priority",
        "dependencies"
      ]
    },
    "Control": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
        },
        "targetId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
        },
        "criterion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "required": {
          "type": "boolean"
        },
        "criticality": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ]
        },
        "ttlSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31536000
        },
        "applicability": {
          "type": "string",
          "enum": [
            "APPLICABLE",
            "NOT_APPLICABLE"
          ]
        },
        "rationale": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "required": [
        "id",
        "targetId",
        "criterion",
        "scope",
        "method",
        "required",
        "criticality",
        "ttlSeconds",
        "applicability",
        "rationale"
      ]
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
        },
        "controlId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "operator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "observedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "validUntil": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "result": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED"
          ]
        },
        "provenance": {
          "type": "string",
          "enum": [
            "VERIFIED_MANUAL",
            "MACHINE"
          ]
        },
        "revoked": {
          "type": "boolean"
        },
        "supersedes": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
          }
        }
      },
      "required": [
        "id",
        "controlId",
        "scope",
        "source",
        "method",
        "operator",
        "observedAt",
        "validUntil",
        "result",
        "provenance",
        "revoked",
        "supersedes"
      ]
    },
    "Finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
        },
        "targetId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
        },
        "severity": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ]
        },
        "impact": {
          "type": "string",
          "maxLength": 4000
        },
        "remediation": {
          "type": "string",
          "maxLength": 4000
        },
        "status": {
          "type": "string",
          "enum": [
            "OPEN",
            "IN_PROGRESS",
            "RESOLVED",
            "ACCEPTED_RISK"
          ]
        }
      },
      "required": [
        "id",
        "targetId",
        "severity",
        "impact",
        "remediation",
        "status"
      ]
    },
    "Runbook": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
        },
        "targetId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "preconditions": {
          "type": "string",
          "maxLength": 4000
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "risk": {
          "type": "string",
          "maxLength": 4000
        },
        "verification": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "required": [
        "id",
        "targetId",
        "name",
        "preconditions",
        "steps",
        "risk",
        "verification"
      ]
    },
    "AuditEvent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "targetId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
        },
        "before": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4000
        },
        "after": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4000
        }
      },
      "required": [
        "id",
        "timestamp",
        "actor",
        "action",
        "targetId",
        "before",
        "after"
      ]
    },
    "UserStatement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
        },
        "targetId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
        },
        "text": {
          "type": "string",
          "maxLength": 4000
        },
        "declaredAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "operator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "id",
        "targetId",
        "text",
        "declaredAt",
        "operator"
      ]
    },
    "Catalog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "nodes": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "$ref": "#/$defs/Node"
          }
        },
        "edges": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "$ref": "#/$defs/Edge"
          }
        },
        "projects": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "$ref": "#/$defs/Project"
          }
        }
      },
      "required": [
        "schemaVersion",
        "nodes",
        "edges",
        "projects"
      ]
    },
    "State": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "tasks": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "$ref": "#/$defs/Task"
          }
        },
        "controls": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "$ref": "#/$defs/Control"
          }
        },
        "evidence": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "findings": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "$ref": "#/$defs/Finding"
          }
        },
        "runbooks": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "$ref": "#/$defs/Runbook"
          }
        },
        "auditEvents": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "$ref": "#/$defs/AuditEvent"
          }
        },
        "userStatements": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "$ref": "#/$defs/UserStatement"
          }
        }
      },
      "required": [
        "schemaVersion",
        "tasks",
        "controls",
        "evidence",
        "findings",
        "runbooks",
        "auditEvents",
        "userStatements"
      ]
    }
  }
}
